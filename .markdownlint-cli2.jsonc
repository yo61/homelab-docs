{
  // Rule config lives in .markdownlint.jsonc (so editors that don't speak cli2
  // config still pick it up); content/.markdownlint.jsonc extends it for MDX.
  // This file carries only cli2-specific settings.
  //
  // Deliberately no "globs" key: cli2 *merges* config globs with the paths given
  // on the command line, so setting it here would make every hook invocation
  // lint the whole repo instead of just the files pre-commit passed it. File
  // selection is the hook's job — staged files locally, all tracked files under
  // `prek run --all-files` in CI.
  //
  // These ignores are therefore a backstop for running the CLI by hand; the hook
  // never sees generated files because git doesn't track them.
  "ignores": [
    "node_modules",
    // Next.js build cache, static export output, and fumadocs-mdx codegen.
    ".next",
    "out",
    ".source",
  ],
}
